# AWS 프로필 (aws configure --profile <name> 으로 만든 것)
AWS_PROFILE=dcode
AWS_REGION=ap-northeast-2

# Telegram bot (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Agent runtime: lambda (저렴) | fargate (장시간 작업) | both (스마트 라우팅)
AGENT_RUNTIME=lambda

# LLM provider: bedrock (AWS IAM, 크레딧 소진) | anthropic (별도 API key 필요)
AI_PROVIDER=bedrock

# 모델 ID — Bedrock 은 "inference profile" 사용 (global. / apac. / us. prefix 필요)
# 검증·POC 단계: Haiku (저렴) / 실사용: Sonnet
AI_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# AI_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# 첫 배포는 Telegram 만 (web build 스킵)
DEPLOY_WEB=false

# Anthropic API key — AI_PROVIDER=anthropic 일 때만 필요
# ANTHROPIC_API_KEY=sk-ant-...
